   "source": [
    "hours = input (\"Enter hours: \")\n",
    "rate = input (\"Enter rate: \")\n",
    "\n",
    "h = float(hours)\n",
    "r = float (rate)\n",
    "\n",
    "if h <= 40 :\n",
    "    pay = float(hours) * float(rate)\n",
    "else :\n",
    "    pay = 40 * float(rate) + (h - 40) * (1.5 * r)\n",
    "\n",
    "print (\"Pay: \", pay)"
   ]
  }
 ],
